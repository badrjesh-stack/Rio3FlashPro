<Window x:Class="RioTech Pro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RioTech Pro" Height="720" Width="1080"
        MinHeight="600" MinWidth="900" Background="#F3F5F8">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="RioTech Pro" FontSize="30" FontWeight="Bold" Foreground="#14243A"/>
            <TextBlock Text="Kia Rio III · диагностика и управление сервисными сессиями" FontSize="15" Margin="0,6,0,0" Foreground="#526174"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,18,0,16">
            <StackPanel>
                <TextBlock Text="Проект автомобиля" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="Kia Rio III · 2016 · 1.6 л · АКПП — идентификаторы ЭБУ ожидают подтверждения" Margin="0,8,0,0"/>
                <TextBlock Text="Адаптер: ELM327 Bluetooth есть у владельца; Scanmatik 2 Pro/3 рассматривается, но пока не приобретён." Margin="0,5,0,0" Foreground="#526174" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Инструменты" FontSize="18" FontWeight="SemiBold"/>
                    <Button Content="Выбрать файл прошивки и проверить SHA-256" Click="InspectFirmware_Click" Margin="0,14,0,0" Height="42"/>
                    <Button Content="Сохранить диагностический отчёт" Click="SaveReport_Click" Margin="0,9,0,0" Height="42"/>
                    <TextBlock Text="Связь с автомобилем" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8"/>
                    <TextBlock Text="Подключение OBD/Scanmatik для Windows пока не включено. Сначала будет реализован и проверен транспорт адаптера, затем — чтение данных." TextWrapping="Wrap" Foreground="#526174"/>
                    <TextBlock Text="Чтение и запись памяти ЭБУ отключены." FontWeight="SemiBold" Foreground="#9A4B18" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Рабочая область" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Grid.Row="1" Text="Готово. Автомобиль не подключён." Margin="0,12,0,12" Foreground="#245A38"/>
                    <TextBox x:Name="OutputText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13" Padding="12"
                             Background="#F7F9FC" BorderBrush="#D8E0EA"
                             Text="Журнал проекта появится здесь.&#x0a;&#x0a;Проверка файла вычисляет контрольную сумму SHA-256. Она НЕ подтверждает совместимость файла с ЭБУ, корректность калибровки или возможность безопасной записи."/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="RioTech Pro · диагностический режим. Не выполняет запись в ЭБУ и не изменяет данные автомобиля." Margin="0,16,0,0" Foreground="#8A3C24" TextWrapping="Wrap"/>
    </Grid>
</Window>
